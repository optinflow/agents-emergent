# Copy this file to .env and fill in real values. Never commit .env.

# --- Desktop container ---
DESKTOP_CONTAINER_NAME=personal-ai-desktop
DESKTOP_PORT=3010
DESKTOP_URL=http://localhost:3010
PUID=1000
PGID=1000
TZ=UTC

# --- Dashboard backend/frontend ---
BACKEND_PORT=8001
FRONTEND_PORT=3000
REACT_APP_BACKEND_URL=http://localhost:8001
CORS_ORIGINS=*

# --- MongoDB ---
DB_NAME=personal_ai_dashboard

# --- GitHub integration (project/setup repo) ---
# Fine-grained PAT scoped to a single repo, Contents: Read and write.
# https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=
GITHUB_REPO_URL=https://github.com/OWNER/REPO.git
GIT_BRANCH=main
